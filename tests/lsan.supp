#
# Mesa's EGL driver keeps 3008 bytes from SDL's offscreen GL setup and is
# unloaded before exit, so LSan sees an unknown module; SDL alone does the
# same (2026-11-12).
leak:SDL_EGL_InitializeOffscreen
